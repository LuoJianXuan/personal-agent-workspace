# Copy to .env, replace every empty secret locally. Never commit .env.
POSTGRES_PASSWORD=
BACKEND_DB_PASSWORD=
RUNTIME_DB_PASSWORD=
JWT_SECRET=
BACKEND_TO_RUNTIME_TOKEN=
RUNTIME_TO_BACKEND_TOKEN=
TENANT_ID=00000000-0000-4000-8000-000000000001
PROJECT_ID=00000000-0000-4000-8000-000000000002
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_USER_A_USERNAME=user-a
SEED_USER_A_PASSWORD=
SEED_USER_B_USERNAME=user-b
SEED_USER_B_PASSWORD=
TOKEN_TTL_HOURS=8
