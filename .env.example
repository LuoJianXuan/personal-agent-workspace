# Copy to .env, replace every empty secret locally. Never commit .env.
POSTGRES_PASSWORD=
BACKEND_DB_PASSWORD=
RUNTIME_DB_PASSWORD=
JWT_SECRET=
BACKEND_TO_RUNTIME_TOKEN=
RUNTIME_TO_BACKEND_TOKEN=
TENANT_ID=00000000-0000-4000-8000-000000000001
PROJECT_ID=00000000-0000-4000-8000-000000000002
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_USER_A_USERNAME=user-a
SEED_USER_A_PASSWORD=
SEED_USER_B_USERNAME=user-b
SEED_USER_B_PASSWORD=
TOKEN_TTL_HOURS=8
WEB_PORT=5173

# Optional project-scoped registry mirror when Docker Hub is unavailable
DOCKER_REGISTRY=docker.io

# Optional model credential, injected only into Runtime. Never commit real keys.
# DEEPSEEK_API_KEY=
REAL_CALL_BUDGET=
REAL_CALL_BUDGET_SINCE=
REAL_MAX_OUTPUT_TOKENS=4096
MCD_MCP_TOKEN=

# Optional personal connectors. Keyring maps key IDs to base64-encoded 32-byte keys.
PERSONAL_CONNECTIONS_ENABLED=false
CONNECTION_SECRET_ACTIVE_KEY_ID=
CONNECTION_SECRET_KEYS=

# Phase 1: opt in only after corresponding verification and budget authorization.
ENABLE_PUBLIC_WEB=false
TAVILY_API_KEY=
SEARCH_CALL_BUDGET=
SEARCH_CALL_BUDGET_SINCE=
COMPUTE_BROKER_URL=
COMPUTE_BROKER_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://host.docker.internal:3000
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_PROJECT_ID=
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_TRACING_ENVIRONMENT=local
# Object storage: local by default. Connect an existing MinIO when selecting s3.
BLOB_STORE_PROVIDER=local
S3_INTERNAL_ENDPOINT=http://host.docker.internal:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=personal-agent
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=600
SANDBOX_PROVIDER=local_docker
