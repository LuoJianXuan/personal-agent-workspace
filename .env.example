# Copy to .env, replace every empty secret locally. Never commit .env.
POSTGRES_PASSWORD=
BACKEND_DB_PASSWORD=
RUNTIME_DB_PASSWORD=
JWT_SECRET=
BACKEND_TO_RUNTIME_TOKEN=
RUNTIME_TO_BACKEND_TOKEN=
TENANT_ID=00000000-0000-4000-8000-000000000001
PROJECT_ID=00000000-0000-4000-8000-000000000002
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_USER_A_USERNAME=user-a
SEED_USER_A_PASSWORD=
SEED_USER_B_USERNAME=user-b
SEED_USER_B_PASSWORD=
TOKEN_TTL_HOURS=8
WEB_PORT=5173

# Optional project-scoped registry mirror when Docker Hub is unavailable
DOCKER_REGISTRY=docker.io

# Optional model credential, injected only into Runtime. Never commit real keys.
# DEEPSEEK_API_KEY=

# Phase 1: opt in only after corresponding verification and budget authorization.
ENABLE_PUBLIC_WEB=false
TAVILY_API_KEY=
SEARCH_CALL_BUDGET=
SEARCH_CALL_BUDGET_SINCE=
COMPUTE_BROKER_URL=
COMPUTE_BROKER_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://host.docker.internal:3000
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_PROJECT_ID=
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_TRACING_ENVIRONMENT=local
